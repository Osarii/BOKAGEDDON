{
  "name": "BONKAGEDDON Run Completion",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bonkageddon/run-completed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9d4f7d22-9d73-4a2e-bab5-d8c69ff0a101",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -720,
        0
      ],
      "webhookId": "bonkageddon-run-completed"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst allowedCharacters = ['bonk', 'byte', 'tank', 'nova', 'hex'];\nconst allowedOutcomes = ['gameover', 'victory'];\nconst errors = [];\n\nconst numericFields = ['score', 'kills', 'level', 'timeSurvivedSeconds'];\nconst numbers = {};\nfor (const field of numericFields) {\n  const raw = body[field];\n  const value = Number(raw);\n  if (raw === null || raw === undefined || raw === '' || !Number.isFinite(value)) {\n    errors.push(field + ' must be numeric');\n  }\n  numbers[field] = value;\n}\n\nconst playerName = String(body.playerName ?? '').trim();\nconst characterId = String(body.characterId ?? '').toLowerCase();\nconst outcome = String(body.outcome ?? '').toLowerCase();\n\nif (body.event !== 'bonkageddon.run.completed') {\n  errors.push('event must be bonkageddon.run.completed');\n}\nif (!playerName) {\n  errors.push('playerName is required');\n}\nif (!allowedCharacters.includes(characterId)) {\n  errors.push('characterId must be one of bonk, byte, tank, nova, hex');\n}\nif (!allowedOutcomes.includes(outcome)) {\n  errors.push('outcome must be gameover or victory');\n}\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      event: body.event ?? null,\n      valid: false,\n      errors,\n      receivedAt: new Date().toISOString()\n    }\n  }];\n}\n\nconst { score, kills, level, timeSurvivedSeconds } = numbers;\nconst classification = outcome === 'victory' || score >= 50000 || kills >= 500\n  ? 'LEGENDARY'\n  : score >= 10000 || level >= 10 || kills >= 100\n    ? 'HIGH_SCORE'\n    : 'NORMAL_RUN';\n\nreturn [{\n  json: {\n    event: 'bonkageddon.run.completed',\n    valid: true,\n    errors: [],\n    receivedAt: new Date().toISOString(),\n    run: {\n      playerName: playerName.slice(0, 20),\n      characterId,\n      outcome,\n      score,\n      kills,\n      level,\n      timeSurvivedSeconds,\n      date: body.date || new Date().toISOString(),\n      classification\n    }\n  }\n}];"
      },
      "id": "08f21c7a-cc83-4fd7-aaef-8ccfb7dbe4c8",
      "name": "Validate and Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const run = $json.run;\nconst minutes = Math.floor(run.timeSurvivedSeconds / 60);\nconst seconds = String(run.timeSurvivedSeconds % 60).padStart(2, '0');\nconst messages = {\n  LEGENDARY: `${run.playerName} became BONKAGEDDON legend with ${run.score} points.`,\n  HIGH_SCORE: `${run.playerName} posted a high-score run: ${run.score} points.`,\n  NORMAL_RUN: `${run.playerName} finished a ${run.outcome} run.`\n};\n\nreturn [{\n  json: {\n    ...$json,\n    analysis: {\n      summary: messages[run.classification],\n      survivalTime: `${minutes}:${seconds}`,\n      leaderboardCandidate: run.classification !== 'NORMAL_RUN',\n      nextAction: run.classification === 'LEGENDARY'\n        ? 'celebrate_legendary'\n        : run.classification === 'HIGH_SCORE'\n          ? 'log_high_score'\n          : 'log_standard_run'\n    }\n  }\n}];"
      },
      "id": "eae7d48a-0ff3-4ebb-94ce-82793a7a9094",
      "name": "Run Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        -80
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.run.classification }}",
                    "rightValue": "LEGENDARY",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "LEGENDARY"
            },
            {
              "conditions": {
                "options": {
